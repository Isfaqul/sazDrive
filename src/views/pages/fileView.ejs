<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/styles/fileView.css" type="text/css" />
  <title><%= title %></title>
</head>

<body>
  <header>
    <nav class="nav">
      <h1 class="logo">Saz <span>Drive</span></h1>
      <div class="nav-right">
        <a class="nav-link" href="/">Home</a>
        <form action="/auth/logout" method="POST">
          <button class="btn btn-secondary" type="submit">Logout</button>
        </form>
      </div>
    </nav>
  </header>
  <main>
    <hgroup class="hero-title-row">
      <div class="hero-title-row-left">
        <a class="btn btn-secondary icon-btn" href="/drive">
          <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3">
            <path d="m294.92-450 227.85 227.85L480-180 180-480l300-300 42.77 42.15L294.92-510H780v60H294.92Z" />
          </svg>
        </a>
        <h2 class="hero-title"><%= file.name %></h2>
      </div>
    </hgroup>
    <section class="file-view-wrapper">
      <div class="fileView">
        <img src="<%= file.url %>" alt="<%= file.name %>" />
      </div>
      <div class="infoView">
        <div>
          <h3 class="infoView-header">File details</h3>
          <% for (let [key, value] of Object.entries(metaData)) { %>
          <div class="info-item">
            <h4 class="info-item-title"><%= key %></h4>
            <p class="info-item-detail"><%= value %></p>
          </div>
          <%}%>
          </div>
          <div class="fileView-action">
            <div class="fileView-action-row">
              <form action="<%= file.folderId ? `/drive/folder/${file.folderId}/file/${file.id}/delete` : `/drive/file/${file.id}/delete` %>" method="POST">
          <button type="submit" class="btn btn-secondary icon-btn">
            <svg xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="#e3e3e3">
              <path d="M292.31-140q-29.92 0-51.12-21.19Q220-182.39 220-212.31V-720h-40v-60h180v-35.38h240V-780h180v60h-40v507.69Q740-182 719-161q-21 21-51.31 21H292.31ZM680-720H280v507.69q0 5.39 3.46 8.85t8.85 3.46h375.38q4.62 0 8.46-3.85 3.85-3.84 3.85-8.46V-720ZM376.16-280h59.99v-360h-59.99v360Zm147.69 0h59.99v-360h-59.99v360ZM280-720v520-520Z" />
            </svg>
          </button>
          </form>
          <a href="<%= file.folderId ? `/drive/folder/${file.folderId}/file/${file.id}/edit` : `/drive/file/${file.id}/edit` %>"">
            <button type=" button" class=" btn btn-secondary icon-btn">
            <svg xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="#e3e3e3">
              <path d="M200-200h50.46l409.46-409.46-50.46-50.46L200-250.46V-200Zm-60 60v-135.38l527.62-527.39q9.07-8.24 20.03-12.73 10.97-4.5 23-4.5t23.3 4.27q11.28 4.27 19.97 13.58l48.85 49.46q9.31 8.69 13.27 20 3.96 11.31 3.96 22.62 0 12.07-4.12 23.03-4.12 10.97-13.11 20.04L275.38-140H140Zm620.38-570.15-50.23-50.23 50.23 50.23Zm-126.13 75.9-24.79-25.67 50.46 50.46-25.67-24.79Z" />
            </svg>
            </button>
          </a>
        </div>
        <form action="<%= file.folderId ? `/drive/folder/${file.folderId}/file/${file.id}/download` : `/drive/file/${file.id}/download` %>" method="POST" class="download-button-form">
          <button type="submit" class="btn btn-primary icon-btn">
            <svg xmlns=" http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="#e3e3e3">
              <path d="M480-328.46 309.23-499.23l42.16-43.38L450-444v-336h60v336l98.61-98.61 42.16 43.38L480-328.46ZM252.31-180Q222-180 201-201q-21-21-21-51.31v-108.46h60v108.46q0 4.62 3.85 8.46 3.84 3.85 8.46 3.85h455.38q4.62 0 8.46-3.85 3.85-3.84 3.85-8.46v-108.46h60v108.46Q780-222 759-201q-21 21-51.31 21H252.31Z" />
            </svg>
            <span>Download</span>
          </button>
        </form>
      </div>
      </div>
    </section>
  </main>
</body>

</html>