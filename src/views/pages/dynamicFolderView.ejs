<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles/home.css" type="text/css">
  <title><%= title %></title>
</head>

<body>
  <header>
    <nav class="nav">
      <h1 class="logo">Saz <span>Drive</span></h1>
      <div class="nav-right">
        <a class="nav-link" href="/">Home</a>
        <form action="/auth/logout" method="POST">
          <button class="btn btn-secondary" type="submit">Logout</button>
        </form>
      </div>
    </nav>
  </header>
  <main>
    <hgroup class="hero-title-row">
      <div class="hero-title-row-left">
        <a class="btn btn-secondary icon-btn" href="/drive">
          <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3">
            <path d="m294.92-450 227.85 227.85L480-180 180-480l300-300 42.77 42.15L294.92-510H780v60H294.92Z" />
          </svg>
        </a>
        <h2 class="hero-title"><%= title %></h2>
      </div>
      <div class="hero-action">
        <a class="btn btn-primary icon-btn" href="/drive/upload?folderId=<%= folderId %>">
          + Add File
        </a>
      </div>
    </hgroup>
    <% if (!files.length) { %>
    <div class="empty-display">
      <p>Nothing to see here. Add something!</p>
    </div>
    <%}%>
    <div class="file-grid">
      <% files.forEach(file => {%>
    <%- include("../partials/file", {file: file}) %>
    <% }) %>
    </div>
  </main>
</body>

</html>