<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles/editForm.css" type="text/css">
  <title><%= title %></title>
</head>

<body>
  <header>
    <nav>
      <h1 class="logo">Saz <span>Drive</span></h1>
    </nav>
  </header>
  <main>
    <h2 class="hero-title">Update folder name</h2>
    <div class="form-container">
      <form action="/drive/folder/<%=folder.id%>/edit" method="POST">
        <div class="form-control">
          <label for="folderName">Folder Name</label>
          <input type="text" id="folderName" name="folderName" placeholder="Enter new name" value="<%= folder.name %>" required>
        </div>
        <input type="hidden" name="id" value="<%= folder.id %>">
        <div class="error-container">
          <% errors.forEach(error=>{ %>
          <p class="error"><%= error.msg %></p>
          <% }) %>
        </div>
        <div class="form-control form-action">
          <a class="btn btn-secondary" href="<%= backUrl %>">Cancel</a>
          <button class="btn btn-primary" type="submit">Update</button>
        </div>
      </form>
    </div>
  </main>
</body>

</html>